# ============================================================================
# Variáveis do aplicativo (app.arvirtual.com.br)
# No deploy, o GitHub Actions gera o .env na VM a partir dos Secrets/Variables.
# Para rodar localmente: copie para .env.local e ajuste.
# ============================================================================

# --- Banco ---
# Local: postgres://usuario:senha@localhost:5432/arvirtual
# No Docker o DATABASE_URL é montado automaticamente a partir do POSTGRES_PASSWORD.
DATABASE_URL=postgres://arvirtual:troque-esta-senha@localhost:5432/arvirtual
POSTGRES_PASSWORD=troque-esta-senha

# --- Segurança (gere com: openssl rand -base64 48) ---
AUTH_SECRET=
# NUNCA troque depois de usar: as senhas e tokens salvos no banco ficam ilegíveis.
ENCRYPTION_KEY=

# --- Endereço público (usado em cookies seguros, OAuth e links de imagens) ---
APP_URL=https://app.arvirtual.com.br
APP_DOMAIN=app.arvirtual.com.br


# --- Primeiro acesso (cria o administrador se o banco estiver vazio) ---
ADMIN_NAME=Kleber Metzger de Farias
ADMIN_EMAIL=kleber@arvirtual.com.br
ADMIN_PASSWORD=

# O certificado A1, as chaves de Gemini, APICPF, Mercado Livre, Shopee e Magalu, e as contas de
# e-mail, são cadastradas na tela Configurações do sistema (ficam criptografadas no banco).

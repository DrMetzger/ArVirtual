# ===== SECRETS (dados do FTP) =====
# GitHub: Settings > Secrets and variables > Actions > aba "Secrets" > New repository secret
FTP_SERVER=ftp.arvirtual.com.br
FTP_USERNAME=seu_usuario_ftp
FTP_PASSWORD=sua_senha_ftp
# Opcionais (se não criar, usa o padrão indicado)
FTP_SERVER_DIR=./public_html/   # pasta do site no servidor; termine com /
FTP_PORT=21
FTP_PROTOCOL=ftp                # ftp, ftps ou ftps-legacy

# ===== VARIABLES (dados exibidos no site, todos opcionais) =====
# GitHub: Settings > Secrets and variables > Actions > aba "Variables"
